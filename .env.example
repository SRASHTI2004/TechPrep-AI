# Copy to `.env` (never commit .env). Docker compose and the backend both read it.

# ---- App ----
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ---- Auth ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
# This email gets the admin role when it registers.
FIRST_ADMIN_EMAIL=

# ---- Database ----
# Local (no Docker): run `uv run --group localdb python scripts/localdb.py url` in backend/
# Docker compose overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg://techprep:techprep@localhost:5432/techprep
POSTGRES_USER=techprep
POSTGRES_PASSWORD=techprep
POSTGRES_DB=techprep

# ---- Background ingestion ----
# inline = run in the API process (lite, no Redis). celery = Redis + worker (full profile).
INGESTION_MODE=inline
REDIS_URL=

# ---- LLM providers (both have free tiers) ----
# Gemini key: https://aistudio.google.com/apikey    Groq key: https://console.groq.com/keys
LLM_PRIMARY=gemini
LLM_FALLBACK=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# ---- Retrieval (defaults are tuned by backend/eval; see docs/DECISIONS.md) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_ENABLED=true
RETRIEVAL_MODE=hybrid
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Rate limits ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute

# ---- Offline evaluation judge ----
EVAL_JUDGE_PROVIDER=groq
EVAL_JUDGE_MODEL=openai/gpt-oss-120b
