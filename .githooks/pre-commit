#!/bin/sh
# Blocks commits that contain personal files or secrets.
# Enable once per clone:  git config core.hooksPath .githooks
# (On Windows, `python3` may be a Microsoft Store stub, so test that each candidate really runs.)
for PY in python3 python py; do
  if "$PY" -c "import sys" >/dev/null 2>&1; then
    exec "$PY" scripts/check_forbidden_files.py
  fi
done
echo "pre-commit: no working Python found; cannot run scripts/check_forbidden_files.py" >&2
exit 1
