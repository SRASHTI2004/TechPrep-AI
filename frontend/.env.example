# Optional. Leave empty to use same-origin /api (Vite dev proxy or nginx in Docker).
VITE_API_URL=
# Where the Vite dev server proxies /api to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Optional shared demo account shown as a "Try the demo" button on the sign-in page.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
